{
  "name": "@jcoreio/poll",
  "version": "0.0.0-development",
  "description": "handy promised-based polling API",
  "scripts": {
    "tc": "toolchain",
    "toolchain": "toolchain",
    "test": "toolchain test",
    "prepublishOnly": "echo This package is meant to be published by semantic-release from the dist build directory. && exit 1"
  },
  "@jedwards1211/js-toolchain": {
    "mochaArgs": [
      "test/**.js",
      "--exit"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jcoreio/poll.git"
  },
  "keywords": [
    "poll",
    "retry"
  ],
  "author": "Andy Edwards",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jcoreio/poll/issues"
  },
  "homepage": "https://github.com/jcoreio/poll#readme",
  "devDependencies": {
    "@jcoreio/toolchain": "^5.8.6",
    "@jcoreio/toolchain-circle": "^5.8.6",
    "@jcoreio/toolchain-esnext": "^5.8.6",
    "@jcoreio/toolchain-flow": "^5.8.6",
    "@jcoreio/toolchain-mocha": "^5.8.6",
    "@jcoreio/toolchain-semantic-release": "^5.8.6",
    "@jcoreio/toolchain-typescript": "^5.8.6",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "chai": "^4.4.1",
    "eslint": "^9.17.0",
    "globals": "^16.0.0",
    "lint-staged": "^15.2.2",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.6.5",
  "dependencies": {
    "@babel/runtime": "^7.26.0"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "@jcoreio/toolchain": {
    "migratedVersion": "5.8.6"
  }
}
